{
    "main": "bin/conductor",
    "output": "conductor.phar",
    "directories": ["bin", "config", "src"],
    "files": ["composer.json"],
    "finder": [
        {
            "in": "vendor"
        }
    ],
    "compression": "GZ",
    "check-requirements": true,
    "dump-autoload": true,
    "exclude-composer-files": false,
    "exclude-dev-files": true,
    "stub": true,
    "banner": "Conductor: one application with every module installed, run against a configuration directory (CTAP-1750)."
}
